{
  "name": "moa-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "seed": "node --import tsx server/src/seed.ts",
    "import:members": "node --import tsx server/src/import-members.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
